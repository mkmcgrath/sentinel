# Copy to .env and edit before running `docker compose up`

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme

# Server
PORT=8080

# Optional: POST here whenever an alert fires (leave unset to disable)
WEBHOOK_URL=

# Optional: simulate fake nodes instead of waiting on real agents
DEMO_MODE=false
DEMO_NODE_COUNT=3
