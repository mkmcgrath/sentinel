[Unit]
Description=Sentinel Monitoring Agent
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/sentinel-agent
ExecStart=/usr/bin/python3 /opt/sentinel-agent/agent.py /opt/sentinel-agent/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
